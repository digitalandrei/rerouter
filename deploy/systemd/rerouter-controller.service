[Unit]
Description=Rerouter Controller
After=network-online.target mariadb.service
Wants=network-online.target

[Service]
Type=simple
User=rerouter
Group=rerouter
EnvironmentFile=/srv/rerouter/.env
ExecStart=/srv/rerouter/rerouter-controller --config /srv/rerouter/config.toml --env-file /srv/rerouter/.env
Restart=always
RestartSec=5
WorkingDirectory=/srv/rerouter
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/rerouter
LockPersonality=true

[Install]
WantedBy=multi-user.target
