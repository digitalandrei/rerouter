# Rerouter environment — template for /etc/rerouter/rerouter.env, which the
# controller's systemd unit loads via EnvironmentFile. Never commit real secrets.

# --- Database (MariaDB, via sqlx) ----------------------------------------------
DATABASE_URL=mysql://rerouter:change-me@127.0.0.1:3306/rerouter

# --- Controller config ----------------------------------------------------------
REROUTER_CONFIG=/etc/rerouter/config.toml

# --- Session / credential encryption keys --------------------------------------
# SESSION_SECRET signs/authenticates session cookies (DB-backed sessions table).
# SECRETS_KEY is the AES-256-GCM key for provider credentials encrypted at rest.
# Generate each with: openssl rand -hex 32
SESSION_SECRET=
SECRETS_KEY=

# --- Auth / 2FA -----------------------------------------------------------------
# TOTP issuer label shown in authenticator apps.
TWO_FACTOR_ISSUER=Rerouter

# --- Email alerts (SMTP, sent by the controller's alert dispatcher) -------------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=alerts@cloudcraft.ro
SMTP_PASSWORD=change-me
SMTP_FROM=alerts@cloudcraft.ro

# --- Reroute provider secrets (referenced by provider_credentials) ------------
# Store actual tokens encrypted via the app or in /etc/rerouter/ (mode 0600),
# not here. These are placeholders for local dev only.
# CLOUDFLARE_API_TOKEN=
# SCRUBBER_API_TOKEN=
