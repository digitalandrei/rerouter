# Rerouter environment — REFERENCE COPY. `rerouter-controller --install`
# generates this file at /srv/rerouter/.env (mode 0600) with SESSION_SECRET and
# SECRETS_KEY pre-filled (32 random bytes hex each); the systemd unit loads it
# via EnvironmentFile=/srv/rerouter/.env. This copy stays in the repo as
# reference only — keep its KEY SET in sync with ENV_TEMPLATE in
# backend-rust/src/install.rs (the generated file's wording differs slightly).
# Never commit real secrets.

# --- Database (MariaDB, via sqlx) ----------------------------------------------
DATABASE_URL=mysql://rerouter:change-me@127.0.0.1:3306/rerouter

# --- Controller config ----------------------------------------------------------
# Prefer the --config flag (default /srv/rerouter/config.toml; systemd passes it
# explicitly). REROUTER_CONFIG works only as a real PROCESS environment variable:
# it is read at CLI parse time, BEFORE this file is loaded via --env-file, so
# setting it here has no effect.
#REROUTER_CONFIG=/srv/rerouter/config.toml

# --- Session / credential encryption keys --------------------------------------
# SESSION_SECRET signs/authenticates session cookies (DB-backed sessions table).
# SECRETS_KEY is the AES-256-GCM key for device, TOTP, and webhook secrets.
# --install pre-fills both; to generate manually: openssl rand -hex 32
SESSION_SECRET=
SECRETS_KEY=

# --- Auth / 2FA -----------------------------------------------------------------
# TOTP issuer label shown in authenticator apps.
TWO_FACTOR_ISSUER=Rerouter
# Secure is on by default. Set false only for local HTTP testing; production must
# leave this unset/true.
#COOKIE_SECURE=false

# --- Email alerts (SMTP, sent by the controller's alert dispatcher) -------------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=alerts@cloudcraft.ro
SMTP_PASSWORD=change-me
SMTP_FROM=alerts@cloudcraft.ro
